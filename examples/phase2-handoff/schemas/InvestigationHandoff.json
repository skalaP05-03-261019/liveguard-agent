{
  "$defs": {
    "Assessment": {
      "additionalProperties": false,
      "properties": {
        "signals": {
          "items": {
            "$ref": "#/$defs/RiskSignal"
          },
          "maxItems": 4,
          "title": "Signals",
          "type": "array"
        },
        "missingFacts": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "title": "Missingfacts",
          "type": "array"
        }
      },
      "title": "Assessment",
      "type": "object"
    },
    "CaseSnapshot": {
      "properties": {
        "caseId": {
          "format": "uuid",
          "title": "Caseid",
          "type": "string"
        },
        "snapshotId": {
          "format": "uuid",
          "title": "Snapshotid",
          "type": "string"
        },
        "evidenceVersion": {
          "minimum": 1,
          "title": "Evidenceversion",
          "type": "integer"
        },
        "policyVersion": {
          "minLength": 1,
          "title": "Policyversion",
          "type": "string"
        },
        "targetMessageIds": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "minItems": 1,
          "title": "Targetmessageids",
          "type": "array"
        },
        "targetVersions": {
          "additionalProperties": {
            "minimum": 1,
            "type": "integer"
          },
          "propertyNames": {
            "format": "uuid"
          },
          "title": "Targetversions",
          "type": "object"
        },
        "targets": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/SnapshotTarget"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Targets"
        },
        "liveId": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Liveid"
        },
        "userId": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Userid"
        },
        "handlingRoute": {
          "anyOf": [
            {
              "enum": [
                "PASS",
                "RULE_CONFIRMED",
                "CONTEXT_REVIEW",
                "PII_INVESTIGATION",
                "FLOOD_REVIEW"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Handlingroute"
        },
        "ruleId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ruleid"
        },
        "filterVersion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Filterversion"
        },
        "matchingTags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Matchingtags"
        },
        "kickReview": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kickreview"
        },
        "confirmationStatus": {
          "anyOf": [
            {
              "enum": [
                "CONFIRMED",
                "UNCONFIRMED",
                "PENDING",
                "CONFIRMED_VIOLATION",
                "CONFIRMED_NORMAL",
                "CANCELLED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confirmationstatus"
        }
      },
      "required": [
        "caseId",
        "snapshotId",
        "evidenceVersion",
        "policyVersion",
        "targetMessageIds",
        "targetVersions"
      ],
      "title": "CaseSnapshot",
      "type": "object"
    },
    "ChatMessage": {
      "properties": {
        "messageId": {
          "format": "uuid",
          "title": "Messageid",
          "type": "string"
        },
        "authorAlias": {
          "title": "Authoralias",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "sentAt": {
          "format": "date-time",
          "title": "Sentat",
          "type": "string"
        },
        "visibility": {
          "pattern": "^(PUBLIC|HELD|HIDDEN)$",
          "title": "Visibility",
          "type": "string"
        },
        "replyToId": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replytoid"
        }
      },
      "required": [
        "messageId",
        "authorAlias",
        "text",
        "sentAt",
        "visibility"
      ],
      "title": "ChatMessage",
      "type": "object"
    },
    "Quote": {
      "additionalProperties": false,
      "properties": {
        "messageId": {
          "format": "uuid",
          "title": "Messageid",
          "type": "string"
        },
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "messageId",
        "text"
      ],
      "title": "Quote",
      "type": "object"
    },
    "RiskKind": {
      "enum": [
        "REGION_DISPARAGEMENT",
        "GROUP_HATE",
        "TARGETED_ATTACK",
        "PROFANITY_VARIANT"
      ],
      "title": "RiskKind",
      "type": "string"
    },
    "RiskSignal": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/RiskKind"
        },
        "strength": {
          "$ref": "#/$defs/Strength"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Quote"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "reason": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "strength",
        "evidence",
        "reason"
      ],
      "title": "RiskSignal",
      "type": "object"
    },
    "ScreenResult": {
      "additionalProperties": false,
      "properties": {
        "contractVersion": {
          "const": "phase2-screen-v1",
          "default": "phase2-screen-v1",
          "title": "Contractversion",
          "type": "string"
        },
        "requestId": {
          "format": "uuid",
          "title": "Requestid",
          "type": "string"
        },
        "liveId": {
          "format": "uuid",
          "title": "Liveid",
          "type": "string"
        },
        "targetMessageId": {
          "format": "uuid",
          "title": "Targetmessageid",
          "type": "string"
        },
        "experiment": {
          "enum": [
            "clear-only",
            "clear-or-possible",
            "include-uncertain"
          ],
          "title": "Experiment",
          "type": "string"
        },
        "selected": {
          "title": "Selected",
          "type": "boolean"
        },
        "assessment": {
          "$ref": "#/$defs/Assessment"
        },
        "usage": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Usage",
          "type": "object"
        },
        "executionAuthorized": {
          "const": false,
          "default": false,
          "title": "Executionauthorized",
          "type": "boolean"
        }
      },
      "required": [
        "requestId",
        "liveId",
        "targetMessageId",
        "experiment",
        "selected",
        "assessment"
      ],
      "title": "ScreenResult",
      "type": "object"
    },
    "SnapshotTarget": {
      "additionalProperties": false,
      "description": "Explicit target metadata from the BE InternalCase DTO; never inferred from context.",
      "properties": {
        "messageId": {
          "format": "uuid",
          "title": "Messageid",
          "type": "string"
        },
        "visibility": {
          "enum": [
            "PUBLIC",
            "HELD",
            "HIDDEN"
          ],
          "title": "Visibility",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "messageId",
        "visibility",
        "version"
      ],
      "title": "SnapshotTarget",
      "type": "object"
    },
    "Strength": {
      "enum": [
        "CLEAR",
        "POSSIBLE",
        "UNCERTAIN"
      ],
      "title": "Strength",
      "type": "string"
    },
    "TaskEnvelope": {
      "additionalProperties": false,
      "properties": {
        "eventId": {
          "format": "uuid",
          "title": "Eventid",
          "type": "string"
        },
        "taskId": {
          "format": "uuid",
          "title": "Taskid",
          "type": "string"
        },
        "caseId": {
          "format": "uuid",
          "title": "Caseid",
          "type": "string"
        },
        "kind": {
          "enum": [
            "ANALYZE",
            "REANALYZE",
            "RESUME_REVIEW",
            "RECONCILE"
          ],
          "title": "Kind",
          "type": "string"
        },
        "threadId": {
          "minLength": 1,
          "title": "Threadid",
          "type": "string"
        },
        "snapshotId": {
          "format": "uuid",
          "title": "Snapshotid",
          "type": "string"
        },
        "expectedEvidenceVersion": {
          "minimum": 1,
          "title": "Expectedevidenceversion",
          "type": "integer"
        },
        "decisionId": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decisionid"
        },
        "reviewKind": {
          "anyOf": [
            {
              "enum": [
                "CONTEXT",
                "KICK"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewkind"
        },
        "reviewId": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewid"
        },
        "traceId": {
          "format": "uuid",
          "title": "Traceid",
          "type": "string"
        }
      },
      "required": [
        "eventId",
        "taskId",
        "caseId",
        "kind",
        "threadId",
        "snapshotId",
        "expectedEvidenceVersion",
        "traceId"
      ],
      "title": "TaskEnvelope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contractVersion": {
      "const": "phase2-investigation-v1",
      "default": "phase2-investigation-v1",
      "title": "Contractversion",
      "type": "string"
    },
    "screening": {
      "$ref": "#/$defs/ScreenResult"
    },
    "task": {
      "$ref": "#/$defs/TaskEnvelope"
    },
    "snapshot": {
      "$ref": "#/$defs/CaseSnapshot"
    },
    "messages": {
      "items": {
        "$ref": "#/$defs/ChatMessage"
      },
      "minItems": 1,
      "title": "Messages",
      "type": "array"
    },
    "executionAuthorized": {
      "const": false,
      "default": false,
      "title": "Executionauthorized",
      "type": "boolean"
    }
  },
  "required": [
    "screening",
    "task",
    "snapshot",
    "messages"
  ],
  "title": "InvestigationHandoff",
  "type": "object"
}
