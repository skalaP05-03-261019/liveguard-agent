# Runner and MCP settings read from process environment; load .env explicitly.
BACKEND_BASE_URL=http://localhost:8080
BUSINESS_MCP_URL=http://127.0.0.1:8002/mcp
RAG_MCP_URL=
# Chat model: explicit opt-in; independent from RAG embeddings. No model default.
MODEL_PROVIDER=openai
MODEL_NAME=
MODEL_API_KEY=
# Active policy version is pending team confirmation; the read loader uses the case response.
POLICY_VERSION=

# Business MCP server settings (read from the process environment).
BUSINESS_MCP_HOST=127.0.0.1
BUSINESS_MCP_PORT=8002
BUSINESS_BACKEND_BASE_URL=http://127.0.0.1:8080
BUSINESS_MCP_AGENT_TOKEN=
BUSINESS_MCP_SERVICE_TOKEN=
BUSINESS_MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*

# RAG policy index settings (read from the process environment).
# POLICY_VERSION above selects app/rag_mcp/policies/policy-v{version}.md; empty means 3.0.
RAG_DB_URL=postgresql://rag:CHANGE_ME@127.0.0.1:5433/rag
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# RAG MCP server settings. RAG_MCP_URL above is the Agent-side URL (e.g. http://127.0.0.1:8003/mcp).
RAG_MCP_HOST=127.0.0.1
RAG_MCP_PORT=8003
RAG_MCP_AGENT_TOKEN=
# Host header allowlist (MCP DNS rebinding protection). In compose add the service name, e.g. rag-mcp:*
RAG_MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*

# Optional LangSmith tracing (JSON trace logs are always emitted without it).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=liveguard-agent
# Harness checkpointer (LangGraph state, `agent` schema is created automatically).
AGENT_CHECKPOINT_DB_URL=postgresql://rag:CHANGE_ME@127.0.0.1:5433/rag

# Backend -> Agent inbound Bearer credential. Separate from MCP/service headers.
AGENT_SERVICE_TOKEN=
# Durable local volume shared by processes on ONE host; never use an ephemeral container path.
AGENT_TASK_DB_PATH=/var/lib/liveguard-agent/tasks.sqlite3
# Trusted server-side async context manager yielding ModerationGateway.
# Leave empty until the BE adapter contract is implemented; readiness stays false.
AGENT_GATEWAY_FACTORY=
