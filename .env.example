# Runner and MCP settings read from process environment; load .env explicitly.
BACKEND_BASE_URL=http://localhost:8080
BUSINESS_MCP_URL=http://127.0.0.1:8002/mcp
RAG_MCP_URL=
# Chat model: explicit opt-in; independent from RAG embeddings. No model default.
MODEL_PROVIDER=openai
MODEL_NAME=
MODEL_API_KEY=
# Active policy version is pending team confirmation; the read loader uses the case response.
POLICY_VERSION=

# Business MCP server settings (read from the process environment).
BUSINESS_MCP_HOST=127.0.0.1
BUSINESS_MCP_PORT=8002
BUSINESS_BACKEND_BASE_URL=http://127.0.0.1:8080
BUSINESS_MCP_AGENT_TOKEN=
BUSINESS_MCP_SERVICE_TOKEN=
# Docker service name is allowed by default; override with actual service names if renamed.
# Explicit values replace the default list. Empty values and a global '*' are invalid.
BUSINESS_MCP_ALLOWED_HOSTS=business-mcp:*,localhost:*,127.0.0.1:*

# RAG policy index settings (read from the process environment).
# Explicit shared deployment version; must match POLICY_VERSION if both are set.
LIVEGUARD_POLICY_VERSION=
# For indexing, POLICY_VERSION selects app/rag_mcp/policies/policy-v{version}.md.
# Unset or empty uses LIVEGUARD_POLICY_VERSION (TBD-08 shared), then config.py DEFAULT_POLICY_VERSION (currently v3.1).
# Label v3.1 and 3.1 read the same source file policy-v3.1.md; the label must equal BE case policyVersion.
# This fallback does not choose the active BE policy; Agent reads each case's policyVersion.
RAG_DB_URL=postgresql://rag:CHANGE_ME@127.0.0.1:5433/rag
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# RAG MCP server settings. RAG_MCP_URL above is the Agent-side URL (e.g. http://127.0.0.1:8003/mcp).
RAG_MCP_HOST=127.0.0.1
RAG_MCP_PORT=8003
RAG_MCP_AGENT_TOKEN=
# Host header allowlist (MCP DNS rebinding protection). In compose add the service name, e.g. rag-mcp:*
RAG_MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*

# Optional LangSmith tracing (JSON trace logs are always emitted without it).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=liveguard-agent
# Harness checkpointer (LangGraph state, `agent` schema is created automatically).
AGENT_CHECKPOINT_DB_URL=postgresql://rag:CHANGE_ME@127.0.0.1:5433/rag

# Backend -> Agent inbound Bearer credential. Separate from MCP/service headers.
AGENT_SERVICE_TOKEN=
# Shared intake: when set, app.main is API-only (no model/MCP/Graph worker).
# Never point multiple hosts at the legacy SQLite file below.
AGENT_INBOX_DB_URL=
# Standalone `uv run --locked python -m app.worker` uses the same PostgreSQL
# database as AGENT_CHECKPOINT_DB_URL, with separate agent_inbox / agent schemas.
# Empty worker ID generates a process UUID. Lease tokens are private, never logged.
AGENT_WORKER_ID=
AGENT_WORKER_LEASE_SECONDS=30
AGENT_WORKER_HEARTBEAT_SECONDS=5
AGENT_WORKER_POLL_SECONDS=0.5
AGENT_WORKER_SHUTDOWN_SECONDS=30
AGENT_WORKER_MAX_ATTEMPTS=3
AGENT_WORKER_BACKOFF_SECONDS=1
# Durable local volume shared by processes on ONE host; never use an ephemeral container path.
AGENT_TASK_DB_PATH=/var/lib/liveguard-agent/tasks.sqlite3
# Trusted server-side async context manager yielding ModerationGateway.
# Integration opt-in: app.integration.http_gateway:configured_gateway
# Leave empty until the BE adapter contract is implemented; readiness stays false.
AGENT_GATEWAY_FACTORY=
