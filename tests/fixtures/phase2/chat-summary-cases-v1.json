        {
          "messageId": "96abc2af-e626-567f-8633-11e1cad690c3",
          "text": "감마 설정 어디 있어요?",
          "minute": 3
        },
        {
          "messageId": "f10ee28c-e593-5a80-8887-1ddec0416847",
          "text": "옵션 그래픽 탭에 있어요",
          "minute": 4
        }
      ]
    },
    {
      "id": "S4",
      "group": "UNRESOLVED",
      "purpose": "의견 충돌·미결 — 결론을 만들어내지 않는지",
      "messages": [
        {
