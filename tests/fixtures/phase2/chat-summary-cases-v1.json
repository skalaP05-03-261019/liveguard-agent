        },
        {
          "messageId": "1d670121-8398-5cd9-8cc1-39571cd23cbc",
          "text": "노말 한 번 더 하자는 사람 많음",
          "minute": 4
        },
        {
          "messageId": "4a6a1536-fe29-5948-aca2-6a19913a65e0",
          "text": "결정은 아직?",
          "minute": 5
