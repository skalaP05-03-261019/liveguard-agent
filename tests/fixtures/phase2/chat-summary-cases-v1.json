        {
          "messageId": "28f49994-4561-5fb4-8e51-91f1cbec8fa7",
          "text": "장비 다 맞췄으니 가능",
          "minute": 2
        },
        {
          "messageId": "9495ea77-7280-5cc9-acf9-ea8ec5157866",
          "text": "투표하면 좋겠다",
